# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

UROPAY_BUTTON_ID=your_uropay_button_id
UROPAY_API_KEY=your_uropay_api_key
VITE_API_URL=http://localhost:3000

# Gmail SMTP Credentials
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_digit_gmail_app_password

# ==============================================================================
# HOW TO CREATE GMAIL APP PASSWORD:
#  1. Enable 2-Step Verification in your Google account settings.
#  2. Search for "App Passwords" in your account search bar.
#  3. Generate a new app password and select "Mail" (or "Other" and type "OmniCart").
#  4. Google will output a 16-digit password (e.g., "abcd efgh ijkl mnop").
#  5. Copy that 16-character code (remove spaces if manually copying) and paste it into EMAIL_PASS.
#
# HOW TO CONFIGURE UROPAY WEBHOOK:
#  1. Log in to your UroPay Dashboard.
#  2. Navigate to Developer Settings / Webhooks.
#  3. Enter the Webhook URL:
#     https://omnicart-992111359826.us-west1.run.app/api/webhook/uropay
#  4. Enable payment events (specifically event type: "payment.success" or similar).
#
# HOW TO TEST & TROUBLESHOOT:
#  - Check server stdout logs for output starting with:
#    - "[OrderController] Creating pending order..."
#    - "[Webhook] Raw received payload..."
#    - "[Webhook] Processing orderId..."
#    - "[Webhook] Sending confirmation email..."
#    - "[OrderController] Backup saveOrder triggered..."
#    - "[EmailService] Email successfully sent..."
# ==============================================================================
