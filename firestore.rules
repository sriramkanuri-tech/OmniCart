rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30
        && data.avatar is string && data.avatar.size() <= 500
        && (data.balance == null || data.balance is number)
        && (data.points == null || data.points is number);
    }

    // Transaction Validation
    function isValidTransaction(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.subtitle is string && data.subtitle.size() <= 300
        && data.amount is number
        && data.type is string && (data.type == 'in' || data.type == 'out')
        && data.status is string && data.status.size() <= 50;
    }

    // Order Validation
    function isValidOrder(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.subtitle is string && data.subtitle.size() <= 300
        && data.amount is number
        && data.status is string && data.status.size() <= 100
        && data.type is string && data.type.size() <= 50
        && (data.image == null || (data.image is string && data.image.size() <= 500));
    }

    // Reward Validation
    function isValidReward(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.desc is string && data.desc.size() <= 1000
        && data.points is number
        && data.status is string && (data.status == 'Available' || data.status == 'Claimed')
        && (data.code == null || (data.code is string && data.code.size() <= 100))
        && (data.date == null || (data.date is string && data.date.size() <= 100));
    }

    // Bank Account Validation
    function isValidBankAccount(data) {
      return data.bankName is string && data.bankName.size() > 0 && data.bankName.size() <= 200
        && data.accountNumber is string && data.accountNumber.size() > 0 && data.accountNumber.size() <= 50
        && data.accountType is string && data.accountType.size() > 0 && data.accountType.size() <= 50
        && data.holderName is string && data.holderName.size() > 0 && data.holderName.size() <= 200;
    }

    // Card Validation
    function isValidCard(data) {
      return data.cardHolder is string && data.cardHolder.size() > 0 && data.cardHolder.size() <= 200
        && data.cardNumber is string && data.cardNumber.size() > 0 && data.cardNumber.size() <= 50
        && data.expiry is string && data.expiry.size() > 0 && data.expiry.size() <= 20
        && data.cvv is string && data.cvv.size() > 0 && data.cvv.size() <= 10
        && data.cardType is string && data.cardType.size() > 0 && data.cardType.size() <= 50;
    }

    // Address Validation
    function isValidAddress(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.street is string && data.street.size() > 0 && data.street.size() <= 400
        && data.city is string && data.city.size() > 0 && data.city.size() <= 100
        && data.state is string && data.state.size() > 0 && data.state.size() <= 100
        && data.zip is string && data.zip.size() > 0 && data.zip.size() <= 20
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30;
    }

    // Collection match blocks
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) 
        && incoming().email == existing().email; // Immutable Email
      allow delete: if false;

      // Subcollection: Transactions
      match /transactions/{transactionId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming());
        allow update: if isOwner(userId) && isValidTransaction(incoming()) 
          && incoming().amount == existing().amount // Immutable Amount/Type
          && incoming().type == existing().type;
        allow delete: if isOwner(userId);
      }

      // Subcollection: Orders
      match /orders/{orderId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(orderId) && isValidOrder(incoming());
        allow update: if isOwner(userId) && isValidOrder(incoming());
        allow delete: if isOwner(userId);
      }

      // Subcollection: Rewards
      match /rewards/{rewardId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(rewardId) && isValidReward(incoming());
        allow update: if isOwner(userId) && isValidReward(incoming());
        allow delete: if isOwner(userId);
      }

      // Subcollection: Bank Accounts
      match /bankAccounts/{accountId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(accountId) && isValidBankAccount(incoming());
        allow update: if isOwner(userId) && isValidBankAccount(incoming());
        allow delete: if isOwner(userId);
      }

      // Subcollection: Cards
      match /cards/{cardId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(cardId) && isValidCard(incoming());
        allow update: if isOwner(userId) && isValidCard(incoming());
        allow delete: if isOwner(userId);
      }

      // Subcollection: Addresses
      match /addresses/{addressId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(addressId) && isValidAddress(incoming());
        allow update: if isOwner(userId) && isValidAddress(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
