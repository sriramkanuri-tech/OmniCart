rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared validation functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Admins can do anything
    // For now, we'll use a simple check or rely on server-side admin SDK
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'ADMIN';
    }

    match /users/{email} {
      allow read: if isSignedIn() && (request.auth.token.email == email || isAdmin());
      allow write: if isAdmin(); // Only admins can manage users directly in firestore for now
    }

    match /orders/{orderId} {
      allow read: if isSignedIn(); // Basic read for now
      allow write: if isAdmin(); // Writes primarily from server/webhook
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
