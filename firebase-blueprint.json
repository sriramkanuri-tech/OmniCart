{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user for authentication and management",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string", "enum": ["USER", "ADMIN"] }
      },
      "required": ["email", "name", "role"]
    },
    "Order": {
      "title": "Order",
      "description": "Product purchase order",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "productName": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "PAID", "FAILED"] },
        "createdAt": { "type": "string" },
        "uropayStatus": { "type": "string" },
        "emailSent": { "type": "boolean" }
      },
      "required": ["orderId", "userEmail", "status", "amount"]
    },
    "Product": {
      "title": "Product",
      "description": "Store product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "string" },
        "rate": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "badge": { "type": "string" },
        "rating": { "type": "string" },
        "brand": { "type": "string" }
      },
      "required": ["id", "name", "price", "rate", "category"]
    },
    "Offer": {
      "title": "Offer",
      "description": "Store offer/discount banner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "discount": { "type": "string" },
        "category": { "type": "string" },
        "bannerImage": { "type": "string" },
        "validUntil": { "type": "string" },
        "badge": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "title", "discount", "active"]
    }
  },
  "firestore": {
    "users/{email}": {
      "schema": "User",
      "description": "Users collection keyed by email"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "All orders created in the system"
    },
    "products/{id}": {
      "schema": "Product",
      "description": "Products available in store"
    },
    "offers/{id}": {
      "schema": "Offer",
      "description": "Active promotional offers"
    }
  }
}
